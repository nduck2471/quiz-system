rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email in [
               "sepminh169@gmail.com"
             ];
    }

    function validCfgWindow(d, cfg) {
      return d.run == cfg.startMs &&
             d.examId == cfg.examId &&
             request.time.toMillis() >= cfg.startMs - 15000 &&
             request.time.toMillis() <= cfg.endMs + 300000;
    }

    function validSubWindow(d) {
      let path = /databases/$(database)/documents/config/$(d.session);
      return d.session in ['pre', 'post'] &&
             exists(path) &&
             validCfgWindow(d, get(path).data);
    }

    match /config/{s} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /paper/{s} {
      allow read: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        request.time.toMillis() >= resource.data.startMs - 10000 &&
        request.time.toMillis() <= resource.data.endMs
      );
      allow write: if isAdmin();
    }

    match /exams/{id} {
      allow read, write: if isAdmin();
    }

    match /secret/{doc=**} {
      allow read, write: if isAdmin();
    }

    match /subs/{subId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        (resource == null || resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        validSubWindow(request.resource.data);
      allow update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        resource.data.uid == request.auth.uid &&
        resource.data.final != true &&
        validSubWindow(request.resource.data);
      allow delete: if isAdmin();
    }

    match /grades/{id} {
      allow read, write: if isAdmin();
    }

    match /archive/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
